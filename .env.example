# ==============================================================================
# SupportFlow AI — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Information & Environment Mode
# Values for APP_ENV: 'development', 'staging', 'production', 'testing'
APP_NAME="SupportFlow AI"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 with pgvector extension)
# In Docker Compose, the backend container communicates with host 'db' automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supportflow_db

# Async Database URL for SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/supportflow_db

# Test Database URL (isolated test database, never points to development DB)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/supportflow_test_db

# Database Connection Pool Tuning
# Production recommendation: pool_size=10, max_overflow=20, timeout=30, recycle=1800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Configuration (Rate Limiting, Session State & Caching)
# In Docker Compose, the backend container communicates with host 'redis' automatically.
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
# In production: generate a strong 32+ character random secret using:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Reverse Proxy & Client IP Trust Configuration
# Set to True when running behind Nginx / Caddy / Traefik to extract real client IP.
# Set to False if the application is directly exposed without an edge proxy.
TRUST_PROXY_HEADERS=True

# CORS & Security Headers
# In production: specify exact comma-separated allowed origins (no trailing slashes)
# Example: CORS_ORIGINS="https://supportflow.example.com,https://app.example.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
ENABLE_SECURITY_HEADERS=True
HSTS_ENABLED=False
ENABLE_DOCS=True

# Rate Limiting Configuration (requests per minute)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=20
RATE_LIMIT_UPLOAD=10

# Request Size & File Upload Limits (bytes)
# 10 MB = 10485760 bytes
MAX_REQUEST_BODY_SIZE=10485760
MAX_FILE_UPLOAD_SIZE=10485760

# LLM Provider Configuration (Groq)
# Required for RAG generation and agent execution.
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Embedding Settings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K=5
CONFIDENCE_THRESHOLD=0.75
MAX_AI_INPUT_CHARS=4000
MAX_GRAPH_STEPS=15

# Docker Compose Port & URL Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API URL configuration
# Leave empty to use relative Nginx reverse proxy (/api)
# Or set to http://localhost:8000 for direct host-to-backend communication
VITE_API_BASE_URL=

# ==============================================================================
# Local Demo Accounts (FOR LOCAL DEMONSTRATION ONLY)
# Used by scripts/demo_seed.py for interactive walkthroughs and portfolio evaluations.
# NEVER enable or deploy these credentials in production environments.
# ==============================================================================
DEMO_CUSTOMER_EMAIL=demo.customer@example.com
DEMO_CUSTOMER_PASSWORD=DemoCustomer123!

DEMO_AGENT_EMAIL=demo.agent@example.com
DEMO_AGENT_PASSWORD=DemoAgent123!

DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=DemoAdmin123!


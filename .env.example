# Environment Configuration for SupportFlow AI
# Copy this file to .env and adjust values for your local environment

APP_NAME="SupportFlow AI"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supportflow_db

# Async Database URL for SQLAlchemy (asyncpg driver)
# Note: In Docker Compose, the backend container uses host 'db' automatically
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/supportflow_db

# Test Database URL (isolated test database, never points to development DB)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/supportflow_test_db

# Redis Configuration (Caching, Task State, Rate Limiting)
# Note: In Docker Compose, the backend container uses host 'redis' automatically
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Embedding Settings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K=5
CONFIDENCE_THRESHOLD=0.75

# Docker Compose Port & URL Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API URL configuration
# Leave empty to use relative Nginx reverse proxy (/api)
# Or set to http://localhost:8000 for direct host-to-backend communication
VITE_API_BASE_URL=
